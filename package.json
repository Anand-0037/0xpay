{
  "name": "0xpay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node init && vite",
    "build": "node init && npm run check:core && vite build && node scripts/alias-wallet-route.mjs",
    "lint": "oxlint",
    "test": "tsx --tsconfig tsconfig.app.json --test tests/*.test.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check:core": "tsc --ignoreConfig --noEmit --target es2023 --module esnext --moduleResolution bundler --jsx react-jsx --allowImportingTsExtensions --skipLibCheck --types vite/client --strict --noUnusedLocals --noUnusedParameters src/main.tsx src/pool/circomlibjs.d.ts"
  },
  "dependencies": {
    "@anon-rpc/browser-harness": "^0.4.0",
    "@forshtat/hegota-support": "^0.0.1",
    "buffer": "6.0.3",
    "circomlibjs": "^0.1.7",
    "ethers": "6.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "snarkjs": "^0.7.6",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/snarkjs": "0.7.9",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-node-polyfills": "0.28.0"
  },
  "overrides": {
    "underscore": "1.13.8",
    "ws": "8.22.1"
  }
}
