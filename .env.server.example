# Copy to .env.server locally. Never put an inference key in VITE_*.
OG_ROUTER_API_KEY=
OG_MODEL=0gm-1.0-35b-a3b
# Two model calls per research job. This process-local cap is not user authentication.
OG_MAX_JOBS=20
PORT=4203
HOST=127.0.0.1
APP_ORIGINS=http://127.0.0.1:4202,http://localhost:4202,http://localhost:5173
# Production only after deployment approval: serve the built dist/ in one service.
SERVE_STATIC=false
